{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    <div class="d-flex justify-content-center align-items-center">
        <form method="post" class="w-50">
            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="mb-3">
                    You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
                </div>
            {% endif %}


            <div class="form-container mt-5 ">
                <h3 contenteditable="true" spellcheck="false" class="">Se connecter</h3>

                <div class="form-floating mb-3">
                    <input type="email" class="form-control" value="{{ last_username }}" id="inputEmail" name="email"
                           placeholder="Email" autocomplete="email" required autofocus>
                    <label for="emailInput">Email</label>
                </div>

                <div class="form-floating mb-3">
                    <input type="password" class="form-control" id="inputPassword" name="password"
                           placeholder="Mot de passe" required autofocus>
                    <label for="inputPassword">Mot de passe</label>
                </div>
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                       value="{{ csrf_token('authenticate') }}">
                <div class="checkbox mb-3">
                    <label>
                        <input type="checkbox" name="_remember_me"> Se rappeler de moi
                    </label>
                </div>
                <div class="mb-3">
                    <a href="{{ path('app_register') }}">Je n'ai pas encore de compte </a>
                </div>
                <div>
                    <button type="submit" class="btn-submit">Send Message</button>
                </div>
            </div>
        </form>
    </div>
{% endblock %}
